# ============================================================================
# BotAutoTask — Environment Variables (.env.example)
# Luật C16 & PK-RELEASE-R01: Mọi biến môi trường phải khai báo ở đây (không chứa
# giá trị thật) và mô tả chi tiết tại docs/reference/config.md. Không commit .env.
# ============================================================================

# --- Local Web UI & Daemon ---
BOTAUTOTASK_UI_TOKEN=
BOTAUTOTASK_CLOUD_URL=
BOTAUTOTASK_API_TOKEN=

# --- Pluggable Harnesses & Zero-Key Auth ---
OPENCODE_ATTACH_URL=
OPENCODE_CONFIG_CONTENT=
CODEX_HOME=
CLAUDE_CONFIG_DIR=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Mobile & Webhook Notifications (ntfy.sh / Discord) ---
NTFY_SERVER=
NTFY_TOPIC=
NTFY_TOKEN=
DISCORD_WEBHOOK_URL=

# --- Cloudflare Auto-Provisioning & Cloud-Core Worker Secrets ---
CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
GITHUB_PAT=
GITHUB_WORKFLOW_FILE=
